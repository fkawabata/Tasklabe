<?xml version="1.0" encoding="utf-8"?>
<!--
    タイポグラフィ（UI デザイン設計書 2.5 節）。Fluent 2 の Windows の書体の段階に合わせる。
    欧文・数字は Segoe UI Variable、和文は BIZ UDP ゴシックで表示する。
    BIZ UDP ゴシックは Regular / Bold のみのため、Fluent 2 で Semibold とする段階は Bold とする。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, BIZ UDPGothic</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, BIZ UDPGothic</FontFamily>

    <!-- 標準コントロールの既定フォントを置き換える -->
    <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="Font.UI" />

    <!-- Title: 画面の見出し -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Subtitle: カードの見出し、空の状態の見出し -->
    <Style x:Key="Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Body Large: 強調したい本文 -->
    <Style x:Key="Text.BodyLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <!-- 完了・中止したタスク名など、目立たなくする本文 -->
    <Style x:Key="Text.Body.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Body Strong: セクションの見出し、表の見出し、子を持つ行 -->
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Caption: 補足、軸目盛り、バッジ。これより小さい文字は用いない -->
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Metric: 状況の主要数値（Title と同じ大きさ） -->
    <Style x:Key="Text.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
</ResourceDictionary>
