<?xml version="1.0" encoding="utf-8"?>
<!--
    デザイントークン（UI デザイン設計書 2 章）。
    画面の XAML ではここで定義したキーのみを参照し、色値を直接書かない。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- アクセント: 標準コントロールの配色をブランドに揃える -->
            <Color x:Key="SystemAccentColor">#0D9488</Color>
            <Color x:Key="SystemAccentColorLight1">#14B8A6</Color>
            <Color x:Key="SystemAccentColorLight2">#2DD4BF</Color>
            <Color x:Key="SystemAccentColorLight3">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorDark1">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark2">#115E59</Color>
            <Color x:Key="SystemAccentColorDark3">#134E4A</Color>

            <SolidColorBrush x:Key="Brand.Accent" Color="#0D9488" />

            <!-- データ可視化 -->
            <SolidColorBrush x:Key="Viz.Progress" Color="#0D9488" />
            <SolidColorBrush x:Key="Viz.ProgressRemain" Color="#0D9488" Opacity="0.28" />
            <SolidColorBrush x:Key="Viz.Delay" Color="#D03B3B" />
            <SolidColorBrush x:Key="Viz.Today" Color="#4A3AA7" />
            <SolidColorBrush x:Key="Viz.Holiday" Color="#000000" Opacity="0.04" />
            <SolidColorBrush x:Key="Viz.Grid" Color="#E1E0D9" />
            <StaticResource x:Key="Viz.Plan" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="Viz.Done" ResourceKey="TextFillColorDisabledBrush" />
            <SolidColorBrush x:Key="Viz.Milestone" Color="#3B6FD4" />

            <!--
                育つ面（ピッカー・メニュー）と、その起点のボタン（UI デザイン設計書 2.2 節）。ポインターを載せたボタンは
                開いた面と同じ色にし、押すとその色のまま面が育つ。ライトでは、閉じたボタンをわずかに沈め、
                載せると面と同じ白になる。面の中の印は沈める
            -->
            <SolidColorBrush x:Key="Morph.Trigger" Color="#FAFAFA" />
            <SolidColorBrush x:Key="Morph.TriggerHover" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Morph.Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Morph.Stroke" Color="#E9E9E9" />
            <SolidColorBrush x:Key="Morph.StrokeHover" Color="#C4C4C4" />
            <SolidColorBrush x:Key="Morph.Highlight" Color="#12000000" />
            <SolidColorBrush x:Key="Menu.Highlight" Color="#07000000" />

            <!-- 引き出し（Drawer）の幕。(10% 0 0 / .38) -->
            <SolidColorBrush x:Key="Drawer.ScrimFill" Color="#61030303" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#14A394</Color>
            <Color x:Key="SystemAccentColorLight1">#2DD4BF</Color>
            <Color x:Key="SystemAccentColorLight2">#5EEAD4</Color>
            <Color x:Key="SystemAccentColorLight3">#99F6E4</Color>
            <Color x:Key="SystemAccentColorDark1">#0F766E</Color>
            <Color x:Key="SystemAccentColorDark2">#115E59</Color>
            <Color x:Key="SystemAccentColorDark3">#134E4A</Color>

            <SolidColorBrush x:Key="Brand.Accent" Color="#14A394" />

            <SolidColorBrush x:Key="Viz.Progress" Color="#14A394" />
            <SolidColorBrush x:Key="Viz.ProgressRemain" Color="#14A394" Opacity="0.28" />
            <SolidColorBrush x:Key="Viz.Delay" Color="#E66767" />
            <SolidColorBrush x:Key="Viz.Today" Color="#9085E9" />
            <SolidColorBrush x:Key="Viz.Holiday" Color="#FFFFFF" Opacity="0.04" />
            <SolidColorBrush x:Key="Viz.Grid" Color="#2C2C2A" />
            <StaticResource x:Key="Viz.Plan" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="Viz.Done" ResourceKey="TextFillColorDisabledBrush" />
            <SolidColorBrush x:Key="Viz.Milestone" Color="#7AA2F0" />

            <!-- ダークでは、ページ → ボタン → ポインターを載せたボタン・開いた面（同じ色） → 面の中の印 の順に一段ずつ明るくする -->
            <SolidColorBrush x:Key="Morph.Trigger" Color="#262626" />
            <SolidColorBrush x:Key="Morph.TriggerHover" Color="#2C2C2C" />
            <SolidColorBrush x:Key="Morph.Surface" Color="#2C2C2C" />
            <SolidColorBrush x:Key="Morph.Stroke" Color="#393939" />
            <SolidColorBrush x:Key="Morph.StrokeHover" Color="#565656" />
            <SolidColorBrush x:Key="Morph.Highlight" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="Menu.Highlight" Color="#06FFFFFF" />

            <SolidColorBrush x:Key="Drawer.ScrimFill" Color="#61030303" />
        </ResourceDictionary>

        <!-- ハイコントラストではシステムカラーのみを用い、形と線種で区別する -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="Brand.Accent" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Viz.Progress" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Viz.ProgressRemain" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Viz.Delay" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Viz.Today" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="Viz.Holiday" Color="Transparent" />
            <SolidColorBrush x:Key="Viz.Grid" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="Viz.Plan" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Viz.Done" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="Viz.Milestone" Color="{ThemeResource SystemColorHotlightColor}" />

            <!-- ハイコントラストでは面を塗り分けず、ポインターを載せたときは枠の色で示す -->
            <SolidColorBrush x:Key="Morph.Trigger" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="Morph.TriggerHover" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="Morph.Surface" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Morph.Stroke" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="Morph.StrokeHover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Morph.Highlight" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.3" />
            <SolidColorBrush x:Key="Menu.Highlight" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.3" />
            <SolidColorBrush x:Key="Drawer.ScrimFill" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 間隔（4 px 単位） -->
    <x:Double x:Key="Space.XS">4</x:Double>
    <x:Double x:Key="Space.S">8</x:Double>
    <x:Double x:Key="Space.M">12</x:Double>
    <x:Double x:Key="Space.L">16</x:Double>
    <x:Double x:Key="Space.XL">24</x:Double>
    <Thickness x:Key="Padding.Page">24,16,24,24</Thickness>
    <Thickness x:Key="Padding.Card">12</Thickness>

    <!-- 寸法 -->
    <x:Double x:Key="Size.RowCompact">32</x:Double>
    <x:Double x:Key="Size.RowStandard">40</x:Double>
    <!--
        角の丸め（UI デザイン設計書 2.6 節）。値は WinUI の ControlCornerRadius と OverlayCornerRadius に合わせ、
        画面ごとに数値を書かない。両端を半円にする Pill は、大きさで決まるため値を持たず、Controls.Pill で付ける。
    -->
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Overlay">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
</ResourceDictionary>
