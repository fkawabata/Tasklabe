<?xml version="1.0" encoding="utf-8"?>
<!-- タスクの追加だけのウィンドウ: Copilot キーを押したときに開く（要件 F-UI-MY-08、UI デザイン設計書 3.5.2 節） -->
<Window
    x:Class="Tasklabe.App.Views.QuickAddWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tasklabe.App.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトルバー（つかんで動かせる） -->
        <StackPanel
            x:Name="TitleArea"
            Padding="16,0,0,0"
            Orientation="Horizontal"
            Spacing="{StaticResource Space.S}">
            <Image
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/Tasklabe.ico" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="タスクを追加" />
        </StackPanel>

        <controls:NewTaskComposer x:Name="Composer" Grid.Row="1" Margin="24,8,24,0" VerticalAlignment="Top" />

        <!-- 追加とキャンセル -->
        <Grid
            Grid.Row="2"
            Padding="24,16"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="{StaticResource Space.S}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="AddButton"
                Grid.Column="1"
                MinWidth="96"
                Click="OnAdd"
                Content="追加"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Grid.Column="2"
                MinWidth="96"
                Click="OnCancel"
                Content="キャンセル" />
        </Grid>
    </Grid>
</Window>
