<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tasklabe.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tasklabe.App.Controls">

    <ScrollViewer x:Name="Scroller" SizeChanged="OnScrollerSizeChanged">
        <StackPanel x:Name="RootPanel" Padding="{StaticResource Padding.Page}" HorizontalAlignment="Center" Spacing="{StaticResource Space.S}">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                x:Uid="Settings_Title"
                Style="{StaticResource Text.Title}" />

            <!-- 全般（アプリ全体）と、個人・チームのプロジェクトの既定（UI デザイン設計書 3.6 節） -->
            <SelectorBar x:Name="Tabs" Margin="0,0,0,8" controls:TabIndicator.Slides="True" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="GeneralTab" x:Uid="Settings_GeneralTab" IsSelected="True" Tag="general">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="PersonalTab" x:Uid="Settings_PersonalTab" Tag="personal">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="TeamTab" x:Uid="Settings_TeamTab" Tag="team">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <!-- プロジェクトの既定 -->
            <StackPanel x:Name="DefaultsPanel" Spacing="{StaticResource Space.S}" Visibility="Collapsed">
                <TextBlock
                    x:Name="DefaultsIntro"
                    Style="{StaticResource Text.Caption}"
                    TextWrapping="Wrap" />
                <controls:SettingsEditor x:Name="DefaultsEditor" />

                <TextBlock
                    Margin="0,24,0,0"
                    AutomationProperties.HeadingLevel="Level2"
                    x:Uid="Settings_PerProjectHeading"
                    Style="{StaticResource Text.BodyStrong}" />
                <TextBlock
                    x:Uid="Settings_PerProjectDescription"
                    Style="{StaticResource Text.Caption}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="ProjectLinks" Spacing="{StaticResource Space.XS}" />
            </StackPanel>

            <StackPanel x:Name="GeneralPanel" Spacing="{StaticResource Space.S}">
            <!-- 表示の言語（要件 F-SET-08）。起動し直したときに反映する -->
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}">
                <Grid ColumnSpacing="{StaticResource Space.L}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Glyph="&#xF2B7;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="Settings_Language" Style="{StaticResource Text.Body}" />
                        <TextBlock x:Uid="Settings_LanguageDescription" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ContentControl
                        x:Name="LanguageHost"
                        Grid.Column="2"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Stretch" />
                </Grid>
            </Border>

            <TextBlock
                x:Uid="Settings_AppearanceHeading"
                Margin="0,16,0,0"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource Text.BodyStrong}" />

            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}">
                <Grid ColumnSpacing="{StaticResource Space.L}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE790;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="Settings_Theme" Style="{StaticResource Text.Body}" />
                        <TextBlock x:Uid="Settings_ThemeDescription" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- 候補はピッカーで選ぶ（UX 規約 UX-02） -->
                    <ContentControl
                        x:Name="ThemeHost"
                        Grid.Column="2"
                        MinWidth="200"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Stretch" />
                </Grid>
            </Border>

            <!-- 操作のヒント（要件 F-SET-07） -->
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}">
                <Grid ColumnSpacing="{StaticResource Space.L}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE82F;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="Settings_Hints" Style="{StaticResource Text.Body}" />
                        <TextBlock x:Uid="Settings_HintsDescription" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="HintsSwitch"
                        x:Uid="Settings_HintsSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        Toggled="OnHintsToggled" />
                </Grid>
            </Border>

            <!-- カンバン（めったに変えない表示のしかたは、ビューではなくここに置く。UX 規約 UX-23） -->
            <TextBlock
                Margin="0,16,0,0"
                AutomationProperties.HeadingLevel="Level2"
                x:Uid="Settings_KanbanHeading"
                Style="{StaticResource Text.BodyStrong}" />
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}">
                <Grid ColumnSpacing="{StaticResource Space.L}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Glyph="&#xF0E2;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="Settings_EmptyColumns" Style="{StaticResource Text.Body}" />
                        <TextBlock x:Uid="Settings_EmptyColumnsDescription" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="EmptyColumnsSwitch"
                        Grid.Column="2"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        x:Uid="Settings_EmptyColumnsSwitch"
                        Toggled="OnEmptyColumnsToggled" />
                </Grid>
            </Border>

            <!-- 番号（要件 F-SET-06）。カンバンはいつも出すため、ほかの画面だけを選ぶ -->
            <TextBlock
                Margin="0,16,0,0"
                AutomationProperties.HeadingLevel="Level2"
                x:Uid="Settings_NumberHeading"
                Style="{StaticResource Text.BodyStrong}" />
            <Border
                Padding="16,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}">
                <StackPanel>
                    <Grid Padding="0,8" ColumnSpacing="{StaticResource Space.L}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE8FD;" />
                        <TextBlock x:Uid="Settings_NumberInPlan" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Body}" />
                        <ToggleSwitch
                            x:Name="NumberInPlanSwitch"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            x:Uid="Settings_NumberInPlanSwitch"
                            Toggled="OnNumberToggled" />
                    </Grid>
                    <Grid Padding="0,8" ColumnSpacing="{StaticResource Space.L}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE9D2;" />
                        <TextBlock x:Uid="Settings_NumberInGantt" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Body}" />
                        <ToggleSwitch
                            x:Name="NumberInGanttSwitch"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            x:Uid="Settings_NumberInGanttSwitch"
                            Toggled="OnNumberToggled" />
                    </Grid>
                    <Grid Padding="0,8" ColumnSpacing="{StaticResource Space.L}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" Glyph="&#xE7C1;" />
                        <TextBlock x:Uid="Settings_NumberInIssues" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Body}" />
                        <ToggleSwitch
                            x:Name="NumberInIssuesSwitch"
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            x:Uid="Settings_NumberInIssuesSwitch"
                            Toggled="OnNumberToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- キーボード（要件 F-KEY-04） -->
            <Grid Margin="0,16,0,0">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    x:Uid="Settings_KeyboardHeading"
                    Style="{StaticResource Text.BodyStrong}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                    <Button x:Uid="Settings_ShowShortcuts" Click="OnShowShortcuts" />
                    <Button x:Uid="Settings_ResetAllShortcuts" Click="OnResetAllShortcuts" />
                </StackPanel>
            </Grid>
            <TextBlock
                x:Uid="Settings_KeyboardDescription"
                Style="{StaticResource Text.Caption}"
                TextWrapping="Wrap" />
            <StackPanel x:Name="ShortcutSections" Spacing="{StaticResource Space.S}" />

            <TextBlock
                Margin="0,16,0,0"
                AutomationProperties.HeadingLevel="Level2"
                x:Uid="Settings_AccountHeading"
                Style="{StaticResource Text.BodyStrong}" />

            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}">
                <Grid ColumnSpacing="{StaticResource Space.L}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE77B;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountText" Style="{StaticResource Text.Body}" />
                        <TextBlock x:Name="RepositoryText" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        x:Uid="Settings_SignOut"
                        Click="OnSignOutClick" />
                </Grid>
            </Border>

            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}">
                <Grid ColumnSpacing="{StaticResource Space.L}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE716;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="Settings_Organizations" Style="{StaticResource Text.Body}" />
                        <TextBlock
                            x:Name="OrganizationsText"
                            Style="{StaticResource Text.Caption}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <HyperlinkButton
                        x:Name="OrganizationAccessLink"
                        Grid.Column="2"
                        x:Uid="Settings_OrganizationAccess"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
