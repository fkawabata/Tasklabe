<?xml version="1.0" encoding="utf-8"?>
<!-- 共有ビュー: 計画を他の人に説明するためのビューと、Mermaid・画像への書き出し（要件 F-UI-GT-10、UI デザイン設計書 3.3.6 節） -->
<Window
    x:Class="Tasklabe.App.Views.PlanShareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tasklabe.App.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 見出しと書き出しの操作 -->
        <Grid
            Grid.ColumnSpan="2"
            Padding="24,16,24,12"
            ColumnSpacing="{StaticResource Space.M}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource Text.Subtitle}"
                    Text="共有ビュー" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel
                x:Name="CopiedBadge"
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource Space.XS}"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Foreground="{ThemeResource Viz.Progress}" Glyph="&#xE73E;" />
                <TextBlock x:Name="CopiedText" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <Button
                x:Name="CopyImageButton"
                Grid.Column="2"
                Click="OnCopyImage"
                ToolTipService.ToolTip="見えているビューを画像としてコピーします。資料やチャットにそのまま貼れます (Ctrl + Shift + C)"
                AutomationProperties.Name="画像をコピー">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                    <FontIcon FontSize="14" Glyph="&#xEB9F;" />
                    <TextBlock Text="画像をコピー" />
                </StackPanel>
            </Button>
            <Button
                x:Name="CopyButton"
                Grid.Column="3"
                Click="OnCopy"
                ToolTipService.ToolTip="Mermaid の gantt 記法でコピーします。GitHub の Issue や README に貼ると図になります (Ctrl + C)"
                AutomationProperties.Name="Mermaid をコピー">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    <TextBlock Text="Mermaid をコピー" />
                </StackPanel>
            </Button>
            <Button
                x:Name="SaveButton"
                Grid.Column="4"
                Click="OnSave"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Markdown・Mermaid・画像（PNG）のファイルに書き出します (Ctrl + S)"
                AutomationProperties.Name="ファイルに書き出す">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                    <TextBlock Text="ファイルに書き出す…" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 範囲と表示の設定（変えるとすぐにビューへ反映する） -->
        <ScrollViewer Grid.Row="1" Padding="24,0,16,24">
            <StackPanel Spacing="{StaticResource Space.L}">
                <TextBox
                    x:Name="TitleBox"
                    Header="タイトル"
                    TextChanged="OnOptionChanged"
                    AutomationProperties.Name="図のタイトル" />

                <StackPanel Spacing="{StaticResource Space.S}">
                    <!-- 候補から選ぶ項目と日付は、ほかの画面と同じピッカーで選ぶ（UX 規約 UX-02） -->
                    <ContentControl x:Name="RangeHost" HorizontalContentAlignment="Stretch" />
                    <Grid x:Name="CustomRange" ColumnSpacing="{StaticResource Space.S}" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="FromHost" HorizontalContentAlignment="Stretch" />
                        <ContentControl x:Name="ToHost" Grid.Column="1" HorizontalContentAlignment="Stretch" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="期間と重なるタスクを表示します。" TextWrapping="Wrap" />
                </StackPanel>

                <ContentControl x:Name="SectionsHost" HorizontalContentAlignment="Stretch" />

                <StackPanel>
                    <TextBlock Margin="0,0,0,4" Text="含めるもの" />
                    <CheckBox x:Name="MilestonesBox" Click="OnOptionChanged" Content="マイルストーン" />
                    <CheckBox x:Name="ParentBarsBox" Click="OnOptionChanged" Content="親タスクのバー" />
                    <CheckBox x:Name="CompletedBox" Click="OnOptionChanged" Content="完了したタスク" />
                    <CheckBox x:Name="CanceledBox" Click="OnOptionChanged" Content="中止したタスク" />
                    <TextBlock
                        x:Name="FilterNote"
                        Style="{StaticResource Text.Caption}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Margin="0,0,0,4" Text="表示" />
                    <CheckBox x:Name="StatusBox" Click="OnOptionChanged" Content="状態を色で示す（完了・進行中・遅れ）" />
                    <CheckBox x:Name="AssigneeBox" Click="OnOptionChanged" Content="担当者を名前に添える" />
                    <CheckBox x:Name="ProgressBox" Click="OnOptionChanged" Content="進捗率を名前に添える" />
                    <CheckBox x:Name="HolidaysBox" Click="OnOptionChanged" Content="休日を網掛けする" />
                    <CheckBox x:Name="TodayBox" Click="OnOptionChanged" Content="今日の線" />
                </StackPanel>

                <ContentControl x:Name="FormatHost" HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>

        <!-- ビュー（ネイティブで描く）と Mermaid のコード -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,24,24"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="ViewSelector" Margin="8,4" controls:TabIndicator.Slides="True" SelectionChanged="OnViewChanged">
                <SelectorBarItem x:Name="ViewTab" IsSelected="True" Text="ビュー">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="CodeTab" Text="Mermaid のコード">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <ScrollViewer
                x:Name="ViewScroller"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <controls:GanttOutlineView x:Name="Outline" />
            </ScrollViewer>
            <TextBox
                x:Name="CodeBox"
                Grid.Row="1"
                Margin="8,0,8,8"
                AcceptsReturn="True"
                FontFamily="Cascadia Mono, Consolas"
                IsReadOnly="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="NoWrap"
                Visibility="Collapsed"
                AutomationProperties.Name="Mermaid のコード" />
        </Grid>
    </Grid>
</Window>
