<?xml version="1.0" encoding="utf-8"?>
<!-- 共有ビュー: 計画を他の人に説明するためのビューと、Mermaid・画像への書き出し（要件 F-UI-GT-10、UI デザイン設計書 3.3.6 節） -->
<Window
    x:Class="Tasklabe.App.Views.PlanShareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tasklabe.App.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 見出しと書き出しの操作 -->
        <Grid
            Grid.ColumnSpan="2"
            Padding="24,16,24,12"
            ColumnSpacing="{StaticResource Space.M}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    x:Uid="Share_Heading"
                    Style="{StaticResource Text.Subtitle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel
                x:Name="CopiedBadge"
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource Space.XS}"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Foreground="{ThemeResource Viz.Progress}" Glyph="&#xE73E;" />
                <TextBlock x:Name="CopiedText" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <Button
                x:Name="CopyImageButton"
                Grid.Column="2"
                x:Uid="Share_CopyImage"
                Click="OnCopyImage">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                    <FontIcon FontSize="14" Glyph="&#xEB9F;" />
                    <TextBlock x:Uid="Share_CopyImageText" />
                </StackPanel>
            </Button>
            <Button
                x:Name="CopyButton"
                Grid.Column="3"
                x:Uid="Share_CopyMermaid"
                Click="OnCopy">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    <TextBlock x:Uid="Share_CopyMermaidText" />
                </StackPanel>
            </Button>
            <Button
                x:Name="SaveButton"
                Grid.Column="4"
                Click="OnSave"
                x:Uid="Share_Export"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                    <TextBlock x:Uid="Share_ExportText" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 範囲と表示の設定（変えるとすぐにビューへ反映する） -->
        <ScrollViewer Grid.Row="1" Padding="24,0,16,24">
            <StackPanel Spacing="{StaticResource Space.L}">
                <TextBox
                    x:Name="TitleBox"
                    x:Uid="Share_TitleBox"
                    TextChanged="OnOptionChanged" />

                <StackPanel Spacing="{StaticResource Space.S}">
                    <!-- 候補から選ぶ項目と日付は、ほかの画面と同じピッカーで選ぶ（UX 規約 UX-02） -->
                    <ContentControl x:Name="RangeHost" HorizontalContentAlignment="Stretch" />
                    <Grid x:Name="CustomRange" ColumnSpacing="{StaticResource Space.S}" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="FromHost" HorizontalContentAlignment="Stretch" />
                        <ContentControl x:Name="ToHost" Grid.Column="1" HorizontalContentAlignment="Stretch" />
                    </Grid>
                    <TextBlock x:Uid="Share_RangeNote" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                </StackPanel>

                <ContentControl x:Name="SectionsHost" HorizontalContentAlignment="Stretch" />

                <StackPanel>
                    <TextBlock x:Uid="Share_Include" Margin="0,0,0,4" />
                    <CheckBox x:Name="MilestonesBox" x:Uid="Share_Milestones" Click="OnOptionChanged" />
                    <CheckBox x:Name="ParentBarsBox" x:Uid="Share_ParentBars" Click="OnOptionChanged" />
                    <CheckBox x:Name="CompletedBox" x:Uid="Share_Completed" Click="OnOptionChanged" />
                    <CheckBox x:Name="CanceledBox" x:Uid="Share_Canceled" Click="OnOptionChanged" />
                    <TextBlock
                        x:Name="FilterNote"
                        Style="{StaticResource Text.Caption}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Uid="Share_Display" Margin="0,0,0,4" />
                    <CheckBox x:Name="StatusBox" x:Uid="Share_StatusColors" Click="OnOptionChanged" />
                    <CheckBox x:Name="AssigneeBox" x:Uid="Share_Assignees" Click="OnOptionChanged" />
                    <CheckBox x:Name="ProgressBox" x:Uid="Share_Progress" Click="OnOptionChanged" />
                    <CheckBox x:Name="HolidaysBox" x:Uid="Share_Holidays" Click="OnOptionChanged" />
                    <CheckBox x:Name="TodayBox" x:Uid="Share_TodayLine" Click="OnOptionChanged" />
                </StackPanel>

                <ContentControl x:Name="FormatHost" HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>

        <!-- ビュー（ネイティブで描く）と Mermaid のコード -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,24,24"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="ViewSelector" Margin="8,4" controls:TabIndicator.Slides="True" SelectionChanged="OnViewChanged">
                <SelectorBarItem x:Name="ViewTab" x:Uid="Share_ViewTab" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="CodeTab" x:Uid="Share_CodeTab">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <ScrollViewer
                x:Name="ViewScroller"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <controls:GanttOutlineView x:Name="Outline" />
            </ScrollViewer>
            <TextBox
                x:Name="CodeBox"
                Grid.Row="1"
                Margin="8,0,8,8"
                AcceptsReturn="True"
                FontFamily="Cascadia Mono, Consolas"
                IsReadOnly="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="NoWrap"
                x:Uid="Share_CodeBox"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
