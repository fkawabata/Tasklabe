<?xml version="1.0" encoding="utf-8"?>
<!-- プロジェクトの設定（要件 F-SET-02、03、UI デザイン設計書 3.6.1 節） -->
<Page
    x:Class="Tasklabe.App.Views.ProjectSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tasklabe.App.Controls">

    <ScrollViewer x:Name="Scroller" SizeChanged="OnScrollerSizeChanged">
        <StackPanel x:Name="RootPanel" Padding="{StaticResource Padding.Page}" HorizontalAlignment="Center" Spacing="{StaticResource Space.S}">
            <Grid ColumnSpacing="{StaticResource Space.M}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="TitleText"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource Text.Title}" />
                <Border
                    Grid.Column="1"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource Radius.Control}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                        <FontIcon x:Name="KindIcon" FontSize="12" />
                        <TextBlock x:Name="KindText" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <!-- 編集できないこと（UX 規約 UX-31） -->
                <controls:StatusChip x:Name="AccessChip" Grid.Column="2" HorizontalAlignment="Left" />
                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Click="OnBackToProject"
                    AutomationProperties.Name="プロジェクトへ戻る">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                        <TextBlock Text="プロジェクトへ戻る" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock
                x:Name="IntroText"
                Style="{StaticResource Text.Caption}"
                TextWrapping="Wrap" />
            <HyperlinkButton
                x:Name="DefaultsLink"
                Padding="0"
                Click="OnOpenDefaults" />

            <controls:SettingsEditor x:Name="Editor" />
        </StackPanel>
    </ScrollViewer>
</Page>
