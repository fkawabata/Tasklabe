<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tasklabe.App.Views.SignInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Border
            Width="440"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Card}">
            <StackPanel Spacing="{StaticResource Space.L}">
                <StackPanel Spacing="{StaticResource Space.S}">
                    <FontIcon
                        HorizontalAlignment="Left"
                        FontSize="32"
                        Foreground="{ThemeResource Brand.Accent}"
                        Glyph="&#xE9D5;" />
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource Text.Title}"
                        Text="Tasklabe へようこそ" />
                    <TextBlock
                        Style="{StaticResource Text.Body}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="タスクとプロジェクトは GitHub に保存されます。GitHub アカウントでサインインしてください。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasInfo, Mode=OneWay}"
                    Message="{x:Bind ViewModel.InfoText, Mode=OneWay}"
                    Severity="Warning" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                    Severity="Error" />

                <!-- 開始 -->
                <StackPanel Spacing="{StaticResource Space.M}" Visibility="{x:Bind ViewModel.IsWelcome, Mode=OneWay}">
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.SignInCommand}"
                        Content="GitHub でサインイン"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="詳細設定">
                        <TextBox
                            Header="個人用リポジトリ"
                            PlaceholderText="tasklabe-personal"
                            Text="{x:Bind ViewModel.RepositoryName, Mode=TwoWay}" />
                    </Expander>
                </StackPanel>

                <!-- ブラウザでの承認待ち -->
                <StackPanel Spacing="{StaticResource Space.M}" Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay}">
                    <TextBlock
                        Style="{StaticResource Text.Body}"
                        Text="ブラウザで次のコードを入力し、Tasklabe を承認してください。コードはクリップボードにコピーしてあります。"
                        TextWrapping="Wrap" />
                    <Border
                        Padding="16"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource Radius.Control}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="32"
                            CharacterSpacing="200"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.UserCode, Mode=OneWay}"
                            AutomationProperties.Name="確認コード" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsWaiting, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="承認されると自動的に続行します" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                        <Button Command="{x:Bind ViewModel.CopyCodeAndOpenBrowserCommand}" Content="もう一度ブラウザを開く" />
                        <Button Command="{x:Bind ViewModel.CancelCommand}" Content="キャンセル" />
                    </StackPanel>
                </StackPanel>

                <!-- セットアップ中 -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="{StaticResource Space.M}"
                    Visibility="{x:Bind ViewModel.IsSettingUp, Mode=OneWay}">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsSettingUp, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Body}"
                        Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
