<?xml version="1.0" encoding="utf-8"?>
<!--
    詳細パネル（UX 規約 UX-08〜10）。画面の右端から出てくる引き出し（Drawer）に載せる。
    項目は追加のダイアログと同じ順に並べ、そのあとに詳細パネルにしかない項目を続ける。
    候補から選ぶ項目は、値を表示するボタンからピッカーを開いて変える。
-->
<UserControl
    x:Class="Tasklabe.App.Controls.TaskDetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 枠のない入力欄（タイトルと説明を主役にする。追加のダイアログと同じ見た目） -->
        <Style x:Key="FlatTextBox" BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
    </UserControl.Resources>

    <!-- 見出し（番号とプロジェクト、GitHub で開く、閉じる）は、載せる引き出し（Drawer）が持つ -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller">
            <StackPanel x:Name="Fields" Padding="16,12,16,16" Spacing="{StaticResource Space.M}" />
        </ScrollViewer>

        <!-- 下端: 既存のタスクは削除と計画への出し入れ、作成中は追加と破棄 -->
        <StackPanel
            Grid.Row="1"
            Padding="16,8,16,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Spacing="{StaticResource Space.S}">
            <Grid x:Name="ExistingFooter" ColumnSpacing="{StaticResource Space.S}">
                <Button x:Name="DeleteButton" Click="OnDelete">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                        <FontIcon FontSize="14" Foreground="{ThemeResource Viz.Delay}" Glyph="&#xE74D;" />
                        <TextBlock Text="削除…" />
                    </StackPanel>
                </Button>
                <!-- 計画と課題の行き来（要件 F-TSK-09、F-TSK-10）。チームプロジェクトでだけ意味を持つ -->
                <Button
                    x:Name="PlanButton"
                    HorizontalAlignment="Right"
                    Click="OnTogglePlan"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                        <FontIcon x:Name="PlanButtonIcon" FontSize="14" Glyph="&#xE8DE;" />
                        <TextBlock x:Name="PlanButtonText" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="CreateFooter" ColumnSpacing="{StaticResource Space.S}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="CreateButton"
                    HorizontalAlignment="Stretch"
                    Click="OnCreate"
                    Content="追加"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="OnDiscard"
                    Content="破棄" />
            </Grid>
            <TextBlock
                x:Name="HintText"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource Text.Caption}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
