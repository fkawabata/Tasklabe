<?xml version="1.0" encoding="utf-8"?>
<!--
    タスクの追加（UX 規約 UX-08、UX-09、UX-12）。タイトルと説明を主役にし、そのほかの項目は値を載せた小さなボタンから、
    一覧やキーと同じピッカーで選ぶ。足りなければ「詳細を入力…」で、入力を引き継いで詳細パネルへ移る。
-->
<UserControl
    x:Class="Tasklabe.App.Controls.NewTaskComposer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 枠のない入力欄（タイトルと説明を主役にする） -->
        <Style x:Key="FlatTextBox" BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="Layout" Width="460" Spacing="{StaticResource Space.M}">
        <!-- 追加先 -->
        <StackPanel x:Name="ProjectHost" />

        <!-- タイトルと説明 -->
        <StackPanel x:Name="TextFields" Spacing="{StaticResource Space.XS}">
            <TextBox
                x:Name="TitleBox"
                FontSize="20"
                PlaceholderText="タスク名"
                Style="{StaticResource FlatTextBox}"
                AutomationProperties.Name="タスク名" />
            <TextBox
                x:Name="BodyBox"
                MaxHeight="120"
                AcceptsReturn="True"
                PlaceholderText="説明を追加…"
                Style="{StaticResource FlatTextBox}"
                TextWrapping="Wrap"
                AutomationProperties.Name="説明" />
        </StackPanel>

        <!-- 項目（Tab で順に移り、Alt + 文字で直接開く。UX 規約 UX-13） -->
        <StackPanel x:Name="Pills" Orientation="Horizontal" Spacing="{StaticResource Space.XS}" />

        <!-- 詳細パネルへ移るボタンと、キー操作の案内（UX-09、UX-17） -->
        <Grid x:Name="FooterRow" ColumnSpacing="{StaticResource Space.M}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DetailButton" Click="OnDetailClick" AutomationProperties.Name="詳細を入力">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE8A0;" />
                    <TextBlock Text="詳細を入力…" />
                </StackPanel>
            </Button>
            <TextBlock
                x:Name="HintText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource Text.Caption}"
                TextWrapping="Wrap" />
        </Grid>
    </StackPanel>
</UserControl>
