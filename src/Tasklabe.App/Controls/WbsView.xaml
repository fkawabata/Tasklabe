<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tasklabe.App.Controls.WbsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tasklabe.App.Controls"
    xmlns:vm="using:Tasklabe.App.ViewModels">

    <UserControl.Resources>
        <Style x:Key="HeaderText" BasedOn="{StaticResource Text.Caption}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <!-- タイトルのセル。選んでいるときは、値のセルと同じ面（CellFill・CellBorder）で示す -->
        <Style x:Key="TitleCell" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!--
            値のセル。押すとその場でピッカーを開く。選んでいるセルは、ピッカーのボタンと同じ面と濃い枠（CellFill・CellBorder）で示す。
            ポインターを載せたときは薄い面だけを出し、枠は出さない（選んでいるセルと同じ見た目にすると、選択が 2 か所あるように見える）
        -->
        <Style x:Key="ValueCell" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Background="{TemplateBinding Background}"
                            BackgroundSizing="InnerBorderEdge"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Content="{TemplateBinding Content}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Foreground="{TemplateBinding Foreground}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 列見出し。表として読めるよう、見出しに地の色を敷き、下に区切りの線を引く -->
        <Grid
            x:Name="HeaderRow"
            Height="32"
            Padding="4,0,12,0"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource HeaderText}" Text="タスク" />
            <TextBlock Grid.Column="1" Style="{StaticResource HeaderText}" Text="担当" />
            <TextBlock Grid.Column="2" Style="{StaticResource HeaderText}" Text="ステータス" />
            <TextBlock Grid.Column="3" Style="{StaticResource HeaderText}" Text="開始" />
            <TextBlock Grid.Column="4" Style="{StaticResource HeaderText}" Text="終了" />
            <TextBlock Grid.Column="5" HorizontalAlignment="Right" Style="{StaticResource HeaderText}" Text="工数" />
            <TextBlock Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource HeaderText}" Text="進捗" />
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="1"
            AllowDrop="True"
            CanDragItems="True"
            ContainerContentChanging="OnContainerContentChanging"
            ContextRequested="OnRowContextRequested"
            DragItemsStarting="OnDragItemsStarting"
            DragLeave="OnListDragLeave"
            DragOver="OnListDragOver"
            Drop="OnListDrop"
            IsItemClickEnabled="False"
            PreviewKeyDown="OnListPreviewKeyDown"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Extended"
            AutomationProperties.Name="計画の表">
            <!-- 行の出し入れ・入れ替えに、ListView の既定の動きを付けない -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>

            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="{StaticResource Size.RowCompact}" />
                    <Setter Property="Height" Value="{StaticResource Size.RowCompact}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:WbsRowViewModel">
                    <!-- 行の下に区切りの線を引き、表として行を追えるようにする -->
                    <Grid
                        Padding="4,0,12,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        AutomationProperties.Name="{x:Bind AutomationName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>

                        <!--
                            タスク名の列: 階層の字下げ、展開ボタン、状態アイコン、タイトルのセルを別々の要素として並べる。
                            選んでいるときの面・F2 の入力欄・ダブルクリック（詳細を開く）は、タイトルのセル（番号とタイトル）だけが持つ
                        -->
                        <Grid Margin="{x:Bind Indent}" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Width="20"
                                Height="20"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnChevronClick"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind HasChildren}"
                                AutomationProperties.Name="展開／折りたたみ">
                                <FontIcon FontSize="12" Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
                            </Button>
                            <!-- 状態アイコンは、一覧やカンバンと同じく押すとステータスのピッカーを開く -->
                            <Button
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="OnStatusIconClick"
                                IsHitTestVisible="{x:Bind CanEditOwnValues}"
                                Style="{StaticResource SubtleButtonStyle}"
                                IsTabStop="False"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind StatusIconTip}"
                                AutomationProperties.Name="ステータスを変える">
                                <controls:StatusIcon Category="{x:Bind IconCategory}" Progress="{x:Bind Progress}" />
                            </Button>
                            <Border
                                Grid.Column="2"
                                Background="{x:Bind controls:WbsView.CellFill(ActiveColumn, 0), Mode=OneWay}"
                                BorderBrush="{x:Bind controls:WbsView.CellBorder(ActiveColumn, 0), Mode=OneWay}"
                                DoubleTapped="OnTitleDoubleTapped"
                                Style="{StaticResource TitleCell}"
                                Tag="0"
                                Tapped="OnTitleTapped">
                                <StackPanel Margin="4,0" Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource Text.Caption}"
                                        Text="{x:Bind NumberText}"
                                        Visibility="{x:Bind HasNumber}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="{x:Bind TitleWeight}"
                                        Style="{x:Bind controls:TextStyles.Title(IsMuted)}"
                                        Text="{x:Bind Title}"
                                        TextDecorations="{x:Bind TitleDecorations}"
                                        TextTrimming="CharacterEllipsis" />
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE895;"
                                        ToolTipService.ToolTip="GitHub へ送信待ち"
                                        Visibility="{x:Bind IsLocal}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 値のセルは、一覧の値と同じく押すとその場でピッカーを開く。子を持つ行の工数・進捗（積み上げ）は押せない -->
                        <Button
                            Grid.Column="1"
                            Background="{x:Bind controls:WbsView.CellFill(ActiveColumn, 1), Mode=OneWay}"
                            BorderBrush="{x:Bind controls:WbsView.CellBorder(ActiveColumn, 1), Mode=OneWay}"
                            Click="OnValueCellClick"
                            Style="{StaticResource ValueCell}"
                            Tag="1">
                            <TextBlock Style="{x:Bind controls:TextStyles.Value(IsCanceled)}" Margin="8,0" VerticalAlignment="Center" Text="{x:Bind AssigneeText}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <!-- ステータスは「⌄」の付いたボタンの形にし、いまの値を上端に置いたピッカーを開く -->
                        <Button
                            Grid.Column="2"
                            controls:PickerTrigger.IsTrigger="True"
                            IsHitTestVisible="{x:Bind CanEditOwnValues}"
                            Background="{x:Bind controls:WbsView.CellFill(ActiveColumn, 2), Mode=OneWay}"
                            BorderBrush="{x:Bind controls:WbsView.CellBorder(ActiveColumn, 2), Mode=OneWay}"
                            Click="OnValueCellClick"
                            Style="{StaticResource ValueCell}"
                            Tag="2">
                            <Grid ColumnSpacing="4" ToolTipService.ToolTip="{x:Bind StatusTip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{x:Bind controls:TextStyles.Value(IsCanceled)}" Margin="8,0" VerticalAlignment="Center" Text="{x:Bind StatusText}" TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    Grid.Column="1"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE70D;" />
                            </Grid>
                        </Button>
                        <!-- 開始と終了は別の列に示し、どちらを押しても予定（開始〜終了）をまとめて選ぶピッカーを開く -->
                        <Button
                            Grid.Column="3"
                            Background="{x:Bind controls:WbsView.CellFill(ActiveColumn, 3), Mode=OneWay}"
                            BorderBrush="{x:Bind controls:WbsView.CellBorder(ActiveColumn, 3), Mode=OneWay}"
                            Click="OnValueCellClick"
                            Style="{StaticResource ValueCell}"
                            Tag="3">
                            <!-- 親タスクは、子の予定が枠の始まり（この開始日）より前に始まったら、遅れの色ではみ出した稼働日数を添える -->
                            <StackPanel Margin="8,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                <TextBlock VerticalAlignment="Center" Style="{x:Bind controls:TextStyles.Value(IsCanceled)}" Text="{x:Bind StartText}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource Viz.Delay}"
                                    Style="{StaticResource Text.Caption}"
                                    Text="{x:Bind FrameEarlyText}"
                                    ToolTipService.ToolTip="{x:Bind FrameEarlyTip}"
                                    Visibility="{x:Bind HasFrameEarly}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="4"
                            Background="{x:Bind controls:WbsView.CellFill(ActiveColumn, 4), Mode=OneWay}"
                            BorderBrush="{x:Bind controls:WbsView.CellBorder(ActiveColumn, 4), Mode=OneWay}"
                            Click="OnValueCellClick"
                            Style="{StaticResource ValueCell}"
                            Tag="4">
                            <!-- 親タスクは、子の予定が枠（この終了日）を超えたら、遅れの色で超えた稼働日数を添える -->
                            <StackPanel Margin="8,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                <controls:DueDateText
                                    IsOverdue="{x:Bind IsOverdue}"
                                    Text="{x:Bind TargetText}"
                                    TextStyle="{x:Bind controls:TextStyles.Value(IsCanceled)}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource Viz.Delay}"
                                    Style="{StaticResource Text.Caption}"
                                    Text="{x:Bind FrameOverrunText}"
                                    ToolTipService.ToolTip="{x:Bind FrameOverrunTip}"
                                    Visibility="{x:Bind HasFrameOverrun}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="5"
                            IsHitTestVisible="{x:Bind CanEditOwnValues}"
                            Background="{x:Bind controls:WbsView.CellFill(ActiveColumn, 5), Mode=OneWay}"
                            BorderBrush="{x:Bind controls:WbsView.CellBorder(ActiveColumn, 5), Mode=OneWay}"
                            Click="OnValueCellClick"
                            Style="{StaticResource ValueCell}"
                            Tag="5">
                            <TextBlock HorizontalAlignment="Right" Style="{x:Bind controls:TextStyles.Value(IsCanceled)}" Margin="8,0" VerticalAlignment="Center" Text="{x:Bind EstimateText}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button
                            Grid.Column="6"
                            IsHitTestVisible="{x:Bind CanEditOwnValues}"
                            Background="{x:Bind controls:WbsView.CellFill(ActiveColumn, 6), Mode=OneWay}"
                            BorderBrush="{x:Bind controls:WbsView.CellBorder(ActiveColumn, 6), Mode=OneWay}"
                            Click="OnValueCellClick"
                            Style="{StaticResource ValueCell}"
                            Tag="6">
                            <TextBlock HorizontalAlignment="Right" Style="{x:Bind controls:TextStyles.Value(IsCanceled)}" Margin="8,0" VerticalAlignment="Center" Text="{x:Bind ProgressText}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- タイトルの編集の入力欄と、ドラッグ中の落とし先の目印 -->
        <Canvas x:Name="EditorLayer" Grid.Row="1">
            <Border
                x:Name="DropLine"
                Height="2"
                Background="{ThemeResource Brand.Accent}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            <Border
                x:Name="DropInside"
                BorderBrush="{ThemeResource Brand.Accent}"
                BorderThickness="2"
                CornerRadius="{StaticResource Radius.Control}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            <TextBox
                x:Name="Editor"
                MinHeight="0"
                Padding="8,4"
                KeyDown="OnEditorKeyDown"
                LostFocus="OnEditorLostFocus"
                Visibility="Collapsed"
                AutomationProperties.Name="タイトルの編集" />
        </Canvas>

        <!-- 複数を選んでいるときの操作バー（UX 規約 UX-07） -->
        <controls:SelectionBar x:Name="Bar" Grid.Row="1" />
    </Grid>
</UserControl>
