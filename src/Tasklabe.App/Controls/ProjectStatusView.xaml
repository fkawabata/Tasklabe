<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tasklabe.App.Controls.ProjectStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tasklabe.App.Controls">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Spacing="{StaticResource Space.L}">
            <!-- 主要指標 -->
            <Grid ColumnSpacing="{StaticResource Space.M}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <TextBlock Style="{StaticResource Text.Caption}" x:Uid="Status_ProgressLabel" />
                        <TextBlock x:Name="ProgressMetric" Style="{StaticResource Text.Metric}" />
                        <TextBlock x:Name="ProgressCaption" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <TextBlock Style="{StaticResource Text.Caption}" x:Uid="Status_ScheduleLabel" />
                        <TextBlock x:Name="ScheduleMetric" Style="{StaticResource Text.Metric}" />
                        <TextBlock x:Name="ScheduleCaption" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <TextBlock Style="{StaticResource Text.Caption}" x:Uid="Status_DelayedLabel" />
                        <TextBlock x:Name="DelayedMetric" Style="{StaticResource Text.Metric}" />
                        <TextBlock x:Name="DelayedCaption" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <TextBlock Style="{StaticResource Text.Caption}" x:Uid="Status_RemainingLabel" />
                        <TextBlock x:Name="RemainingMetric" Style="{StaticResource Text.Metric}" />
                        <TextBlock x:Name="RemainingCaption" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel Spacing="{StaticResource Space.XS}">
                        <TextBlock Style="{StaticResource Text.Caption}" x:Uid="Status_IssuesLabel" />
                        <TextBlock x:Name="IssueMetric" Style="{StaticResource Text.Metric}" />
                        <TextBlock x:Name="IssueCaption" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- マイルストーン（期限）ごとの進み具合（要件 F-MS-04） -->
            <Border x:Name="MilestoneCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource Space.S}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource Text.Subtitle}"
                        x:Uid="Status_MilestonesHeading" />
                    <StackPanel x:Name="MilestoneRows" Spacing="{StaticResource Space.S}" />
                </StackPanel>
            </Border>

            <!-- 注意が必要なタスク -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="{StaticResource Space.S}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource Text.Subtitle}"
                        x:Uid="Status_AttentionHeading" />
                    <SelectorBar x:Name="AttentionSelector" controls:TabIndicator.Slides="True" SelectionChanged="OnAttentionTabChanged">
                        <SelectorBarItem x:Name="DelayedTab" x:Uid="Status_DelayedTab" IsSelected="True" />
                        <SelectorBarItem x:Name="SoonTab" x:Uid="Status_SoonTab" />
                        <SelectorBarItem x:Name="UnestimatedTab" x:Uid="Status_UnestimatedTab" />
                    </SelectorBar>
                    <StackPanel x:Name="AttentionRows" Spacing="2" />
                    <TextBlock x:Name="AttentionEmpty" Style="{StaticResource Text.Caption}" x:Uid="Status_AttentionEmpty" />
                </StackPanel>
            </Border>

            <!-- 担当者別の負荷 -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="{StaticResource Space.S}">
                    <Grid>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource Text.Subtitle}"
                            x:Uid="Status_WorkloadHeading" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource Text.Caption}"
                            x:Name="CapacityText" />
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                        <Grid x:Name="WorkloadGrid" ColumnSpacing="2" RowSpacing="2" />
                    </ScrollViewer>
                    <TextBlock
                        x:Name="WorkloadEmpty"
                        Style="{StaticResource Text.Caption}"
                        x:Uid="Status_WorkloadEmpty"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
