<?xml version="1.0" encoding="utf-8"?>
<!--
    空の状態と読み込み中の表示（UI デザイン設計書 4.3 節）。
    何もないことを述べるだけでなく、次にできる操作をボタンで示す。
-->
<UserControl
    x:Class="Tasklabe.App.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <StackPanel
        MaxWidth="400"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="{StaticResource Space.S}">
        <ProgressRing
            x:Name="Ring"
            Width="32"
            Height="32"
            IsActive="False"
            Visibility="Collapsed" />
        <FontIcon
            x:Name="Icon"
            HorizontalAlignment="Center"
            FontSize="40"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <TextBlock
            x:Name="TitleText"
            HorizontalAlignment="Center"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource Text.Subtitle}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="MessageText"
            HorizontalAlignment="Center"
            Style="{StaticResource Text.Caption}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <Button
            x:Name="ActionButton"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Click="OnActionClick"
            Style="{StaticResource AccentButtonStyle}"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
