<?xml version="1.0" encoding="utf-8"?>
<!--
    少数の選択肢を横に並べた切り替え（UI デザイン設計書 3.3.4 節）。
    くぼんだ溝の上に、浮いた面（選択の印）を 1 つだけ置き、選んだ項目の下へ滑らせる。
    項目そのものは塗らず、文字の色だけを選択とホバーに合わせて変える。
    項目のスタイルは Themes/Controls.xaml に置く。
-->
<UserControl
    x:Class="Tasklabe.App.Controls.Segmented"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- 溝。高さはツールバーのボタンと同じ 32 にそろえる -->
    <Border
        Height="32"
        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource Radius.Control}">
        <Grid>
            <!-- 選択の印。項目の下に敷き、選んだ項目の位置へ滑らせる。押せる範囲は項目が溝いっぱいに持つ -->
            <Border
                x:Name="Selection"
                Margin="2"
                HorizontalAlignment="Left"
                Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Control}"
                Opacity="0" />
            <StackPanel x:Name="Items" Orientation="Horizontal" />
        </Grid>
    </Border>
</UserControl>
