<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tasklabe.App.Controls.KanbanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tasklabe.App.Controls">

    <UserControl.Resources>
        <!--
            カード（UI デザイン設計書 3.5 節）。
            1 行目: 番号・所属と担当者。2 行目: 状態とタイトル。3 行目: 課題・期日・工数のチップ。
            進み具合は状態のアイコン（作業中は円の塗り）で示す。
        -->
        <DataTemplate x:Key="CardTemplate" x:DataType="controls:KanbanCard">
            <Border
                Padding="12,10,10,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                AutomationProperties.Name="{x:Bind AutomationName}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="6" MinHeight="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource Text.Caption}"
                            Text="{x:Bind NumberText}"
                            Visibility="{x:Bind HasNumber}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Caption}"
                            Text="{x:Bind Caption}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind HasCaption}" />
                        <Button
                            Grid.Column="2"
                            Height="22"
                            MinWidth="22"
                            Padding="0"
                            controls:PickerTrigger.IsCompact="True"
                            controls:PickerTrigger.IsTrigger="True"
                            Click="OnCardAssigneeClick"
                            Style="{StaticResource MorphSelect.IconTrigger}"
                            IsTabStop="False"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind AssigneeTip}"
                            Visibility="{x:Bind IsTeam}"
                            AutomationProperties.Name="{x:Bind AssigneeButtonName}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="2" Visibility="{x:Bind HasAssignee}">
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Background="{x:Bind AvatarBrush}"
                                        controls:Pill.IsEnabled="True">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{x:Bind AvatarInitial}" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Text.Caption}"
                                        Text="{x:Bind MoreAssigneesText}"
                                        Visibility="{x:Bind HasMoreAssignees}" />
                                </StackPanel>
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE77B;"
                                    ToolTipService.ToolTip="担当者なし"
                                    Visibility="{x:Bind IsUnassigned}" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Width="24"
                            Height="24"
                            Margin="-4,-2,0,0"
                            Padding="0"
                            VerticalAlignment="Top"
                            controls:PickerTrigger.IsCompact="True"
                            controls:PickerTrigger.IsTrigger="True"
                            Click="OnCardStatusClick"
                            Style="{StaticResource MorphSelect.IconTrigger}"
                            IsTabStop="False"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind StatusTip}"
                            AutomationProperties.Name="{x:Bind StatusButtonName}">
                            <controls:StatusIcon Category="{x:Bind IconCategory}" Progress="{x:Bind Progress}" />
                        </Button>
                        <TextBlock
                            Grid.Column="1"
                            MaxLines="3"
                            Style="{x:Bind controls:TextStyles.Title(IsMuted)}"
                            Text="{x:Bind Title}"
                            TextDecorations="{x:Bind TitleDecorations}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind HasChips}">
                        <Button
                            controls:PickerTrigger.IsTrigger="True"
                            Click="OnCardStatusClick"
                            Style="{StaticResource Card.Chip}"
                            IsTabStop="False"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind StatusTip}"
                            Visibility="{x:Bind HasStatusName}"
                            AutomationProperties.Name="{x:Bind StatusButtonName}">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Bind StatusText}" />
                        </Button>
                        <Button
                            controls:PickerTrigger.IsTrigger="True"
                            controls:PickerTrigger.ShowsChoice="False"
                            Click="OnCardIssueClick"
                            Style="{StaticResource Card.Chip}"
                            IsTabStop="False"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind controls:KeyHints.Tip('task.plan', '課題（計画に入れる前の検討事項）。押すと計画に移せます')}"
                            Visibility="{x:Bind IsIssue}"
                            AutomationProperties.Name="課題。押すと計画に移せます">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE7C1;" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="課題" />
                            </StackPanel>
                        </Button>
                        <Button
                            controls:PickerTrigger.IsTrigger="True"
                            Click="OnCardDueClick"
                            Style="{StaticResource Card.Chip}"
                            IsTabStop="False"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind controls:KeyHints.Tip('task.due', '期日を決める')}"
                            Visibility="{x:Bind HasTarget}"
                            AutomationProperties.Name="{x:Bind DueButtonName}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE787;"
                                    Visibility="{x:Bind ShowsCalendarIcon}" />
                                <controls:DueDateText IsOverdue="{x:Bind IsOverdue}" Text="{x:Bind TargetText}" TextStyle="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </Button>
                        <Button
                            controls:PickerTrigger.IsTrigger="True"
                            Click="OnCardEstimateClick"
                            Style="{StaticResource Card.Chip}"
                            IsTabStop="False"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind controls:KeyHints.Tip('task.estimate', '想定工数を決める')}"
                            Visibility="{x:Bind HasEstimate}"
                            AutomationProperties.Name="{x:Bind EstimateButtonName}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE916;" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Bind EstimateText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 並び順とグループのボタンは、画面のビューの切り替えの右端に置く（UI デザイン設計書 4.4 節） -->
    <Grid>
        <Border x:Name="BoardHost" />

        <!-- 複数を選んでいるときの操作バー（UX 規約 UX-07） -->
        <controls:SelectionBar x:Name="Bar" />
    </Grid>
</UserControl>
