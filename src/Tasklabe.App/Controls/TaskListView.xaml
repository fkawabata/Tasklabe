<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tasklabe.App.Controls.TaskListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tasklabe.App.Controls"
    xmlns:vm="using:Tasklabe.App.ViewModels">

    <UserControl.Resources>
        <CollectionViewSource x:Name="GroupedTasks" IsSourceGrouped="True" />

        <!-- 列の見出し（UI デザイン設計書 3.4.2 節）。行と同じ列幅にそろえる -->
        <Style x:Key="ColumnHeader" BasedOn="{StaticResource Text.Caption}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            値のセル（UI デザイン設計書 3.4.2 節）。押すと、キーボードと同じピッカーをその場に開き、詳細を開かずに値を変えられる。
            ふだんは文字だけに見せ、ポインターを重ねたときにボタンの面を出す。
        -->
        <Style x:Key="PropertyCell" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- マイタスクの行: 状態、タスク、担当、プロジェクト、工数、進捗、期日 -->
        <DataTemplate x:Key="TaskRow" x:DataType="vm:TaskRowViewModel">
            <Grid ColumnSpacing="{StaticResource Space.XS}" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>

                <Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="OnStatusClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    IsTabStop="False"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind StatusTip}"
                    AutomationProperties.Name="{x:Bind StatusButtonName}">
                    <controls:StatusIcon Category="{x:Bind IconCategory}" Progress="{x:Bind Progress}" />
                </Button>

                <TextBlock
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Style="{x:Bind controls:TextStyles.Title(IsMuted)}"
                    Text="{x:Bind Title}"
                    TextDecorations="{x:Bind TitleDecorations}"
                    TextTrimming="CharacterEllipsis" />
                <!-- 送信待ちの印 -->
                <FontIcon
                    Grid.Column="2"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE895;"
                    ToolTipService.ToolTip="GitHub へ送信待ち"
                    Visibility="{x:Bind IsLocal}" />
                <Button
                    Grid.Column="3"
                    HorizontalContentAlignment="Left"
                    Click="OnAssigneeClick"
                    IsEnabled="{x:Bind CanAssign}"
                    Style="{StaticResource PropertyCell}"
                    IsTabStop="False"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind controls:KeyHints.Tip('task.assign', '担当者を変える')}"
                    AutomationProperties.Name="{x:Bind AssigneeButtonName}">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Bind AssigneeCellText}" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock
                    Grid.Column="4"
                    Margin="6,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Text.Caption}"
                    Text="{x:Bind ProjectName}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="5"
                    HorizontalContentAlignment="Right"
                    Click="OnEstimateClick"
                    Style="{StaticResource PropertyCell}"
                    IsTabStop="False"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind controls:KeyHints.Tip('task.estimate', '想定工数を決める')}"
                    AutomationProperties.Name="{x:Bind EstimateButtonName}">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Bind EstimateText}" />
                </Button>
                <Button
                    Grid.Column="6"
                    HorizontalContentAlignment="Right"
                    Click="OnProgressClick"
                    IsEnabled="{x:Bind CanChangeProgress}"
                    Style="{StaticResource PropertyCell}"
                    IsTabStop="False"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind controls:KeyHints.Tip('task.progress', '進捗率を変える')}"
                    AutomationProperties.Name="{x:Bind ProgressButtonName}">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Bind ProgressText}" />
                </Button>
                <Button
                    Grid.Column="7"
                    HorizontalContentAlignment="Right"
                    Click="OnDueClick"
                    Style="{StaticResource PropertyCell}"
                    IsTabStop="False"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind controls:KeyHints.Tip('task.due', '期日を決める')}"
                    AutomationProperties.Name="{x:Bind DueButtonName}">
                    <controls:DueDateText IsOverdue="{x:Bind IsOverdue}" Text="{x:Bind DueCellText}" TextStyle="{StaticResource Text.Caption}" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- 課題の行（要件 F-UI-IS-01）: 状態、課題、担当、ステータス、期日、更新 -->
        <DataTemplate x:Key="IssueRow" x:DataType="vm:TaskRowViewModel">
            <Grid ColumnSpacing="{StaticResource Space.XS}" AutomationProperties.Name="{x:Bind IssueAutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>

                <Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="OnStatusClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    IsTabStop="False"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind StatusTip}"
                    AutomationProperties.Name="{x:Bind StatusButtonName}">
                    <controls:StatusIcon Category="{x:Bind IconCategory}" Progress="{x:Bind Progress}" />
                </Button>

                <Grid
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    ColumnSpacing="{StaticResource Space.S}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource Text.Caption}"
                        Text="{x:Bind IssueNumberText}"
                        Visibility="{x:Bind HasIssueNumber}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{x:Bind controls:TextStyles.Title(IsMuted)}"
                        Text="{x:Bind Title}"
                        TextDecorations="{x:Bind TitleDecorations}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <FontIcon
                    Grid.Column="2"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE895;"
                    ToolTipService.ToolTip="GitHub へ送信待ち"
                    Visibility="{x:Bind IsLocal}" />
                <Button
                    Grid.Column="3"
                    HorizontalContentAlignment="Left"
                    Click="OnAssigneeClick"
                    IsEnabled="{x:Bind CanAssign}"
                    Style="{StaticResource PropertyCell}"
                    IsTabStop="False"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind controls:KeyHints.Tip('task.assign', '担当者を変える')}"
                    AutomationProperties.Name="{x:Bind AssigneeButtonName}">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Bind AssigneeCellText}" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button
                    Grid.Column="4"
                    HorizontalContentAlignment="Left"
                    Click="OnStatusClick"
                    Style="{StaticResource PropertyCell}"
                    IsTabStop="False"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind controls:KeyHints.Tip('task.status', 'ステータスを変える')}"
                    AutomationProperties.Name="{x:Bind StatusButtonName}">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Bind StatusText}" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button
                    Grid.Column="5"
                    HorizontalContentAlignment="Right"
                    Click="OnDueClick"
                    Style="{StaticResource PropertyCell}"
                    IsTabStop="False"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind controls:KeyHints.Tip('task.due', '期日を決める')}"
                    AutomationProperties.Name="{x:Bind DueButtonName}">
                    <controls:DueDateText IsOverdue="{x:Bind IsOverdue}" Text="{x:Bind DueCellText}" TextStyle="{StaticResource Text.Caption}" />
                </Button>
                <TextBlock
                    Grid.Column="6"
                    Margin="6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource Text.Caption}"
                    Text="{x:Bind UpdatedText}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 列の見出し（マイタスク） -->
        <Grid
            x:Name="TaskHeader"
            Height="32"
            Margin="-4,0,0,0"
            ColumnSpacing="{StaticResource Space.XS}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="104" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource ColumnHeader}" Text="タスク" />
            <TextBlock Grid.Column="3" Margin="6,0" Style="{StaticResource ColumnHeader}" Text="担当" />
            <TextBlock Grid.Column="4" Margin="6,0" Style="{StaticResource ColumnHeader}" Text="プロジェクト" />
            <TextBlock Grid.Column="5" Margin="6,0" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="工数" />
            <TextBlock Grid.Column="6" Margin="6,0" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="進捗" />
            <TextBlock Grid.Column="7" Margin="6,0" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="期日" />
        </Grid>

        <!-- 列の見出し（課題） -->
        <Grid
            x:Name="IssueHeader"
            Height="32"
            Margin="-4,0,0,0"
            ColumnSpacing="{StaticResource Space.XS}"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="136" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource ColumnHeader}" Text="課題" />
            <TextBlock Grid.Column="3" Margin="6,0" Style="{StaticResource ColumnHeader}" Text="担当" />
            <TextBlock Grid.Column="4" Margin="6,0" Style="{StaticResource ColumnHeader}" Text="ステータス" />
            <TextBlock Grid.Column="5" Margin="6,0" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="期日" />
            <TextBlock Grid.Column="6" Margin="6,0" HorizontalAlignment="Right" Style="{StaticResource ColumnHeader}" Text="更新" />
        </Grid>

        <ListView
            x:Name="List"
            Grid.Row="1"
            Margin="-12,0"
            DoubleTapped="OnListDoubleTapped"
            ItemTemplate="{StaticResource TaskRow}"
            ItemsSource="{x:Bind GroupedTasks.View, Mode=OneWay}"
            ContextRequested="OnListContextRequested"
            KeyDown="OnListKeyDown"
            PreviewKeyDown="OnListPreviewKeyDown"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Extended"
            AutomationProperties.Name="タスク一覧">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="{StaticResource Size.RowCompact}" />
                    <Setter Property="Padding" Value="8,0,12,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:TaskGroupViewModel">
                            <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource Text.BodyStrong}" Text="{x:Bind Header}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <!-- 複数を選んでいるときの操作バー（UX 規約 UX-07） -->
        <controls:SelectionBar x:Name="Bar" Grid.Row="1" />
    </Grid>
</UserControl>
