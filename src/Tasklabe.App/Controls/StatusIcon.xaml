<?xml version="1.0" encoding="utf-8"?>
<!-- 状態アイコン（UI デザイン設計書 2.4 節）。一覧と計画の表で共通に使う。色は ThemeResource で、テーマに追従させる -->
<UserControl
    x:Class="Tasklabe.App.Controls.StatusIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tasklabe.App.Controls"
    IsTabStop="False">
    <Grid Width="16" Height="16">
        <FontIcon x:Name="BacklogIcon" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xECE4;" Visibility="Collapsed" />
        <FontIcon x:Name="PendingIcon" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xF2D9;" Visibility="Collapsed" />
        <FontIcon x:Name="TodoIcon" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xEA3A;" />
        <controls:ProgressPie x:Name="DoingIcon" Fill="{ThemeResource Viz.Progress}" Visibility="Collapsed" />
        <FontIcon x:Name="DoneIcon" FontSize="16" Foreground="{ThemeResource Viz.Progress}" Glyph="&#xEC61;" Visibility="Collapsed" />
        <FontIcon x:Name="CanceledIcon" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xEB90;" Visibility="Collapsed" />
    </Grid>
</UserControl>
